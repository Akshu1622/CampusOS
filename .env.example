# MySQL Root Password (required for admin setup)
MYSQL_ROOT_PASSWORD=
# Database Name
MYSQL_DATABASE=university_erp
# Database Host and Port
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Migrator user with DDL rights
DB_MIGRATOR_USER=
DB_MIGRATOR_PASSWORD=

# App user with least privilege (created in Phase 7)
DB_APP_USER=
DB_APP_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# FastAPI CORS configuration (comma separated)
CORS_ORIGINS=http://localhost:5173

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000
